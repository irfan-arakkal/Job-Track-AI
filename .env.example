# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every variable here is validated at startup by src/env.ts.

# --- Database ---------------------------------------------------------------
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack?schema=public"
# Used by integration tests (Phase 13).
TEST_DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack_test?schema=public"

# --- App --------------------------------------------------------------------
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Added in later phases:
# BETTER_AUTH_SECRET=        (Phase 2)
# ANTHROPIC_API_KEY=         (Phase 8)
# CRON_SECRET=               (Phase 11)
