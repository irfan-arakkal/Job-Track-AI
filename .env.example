# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every variable here is validated at startup by src/env.ts.

# --- Database ---------------------------------------------------------------
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack?schema=public"
# Used by integration tests (Phase 13).
TEST_DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack_test?schema=public"
# Used by Playwright end-to-end tests (Phase 13).
E2E_DATABASE_URL="postgresql://jobtrack:jobtrack@localhost:5432/jobtrack_e2e?schema=public"

# --- App --------------------------------------------------------------------
# Public base URL of the app (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (Phase 2) -----------------------------------------------------------
# Signs and encrypts session cookies. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
#   (no openssl? run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"
# Where the app is served. Used to build auth URLs and to check request origins (CSRF protection).
BETTER_AUTH_URL="http://localhost:3000"
# Header holding the real client IP for rate limiting. Must be one your host's proxy SETS
# (overwriting client values). Vercel: "x-vercel-forwarded-for".
TRUSTED_IP_HEADERS="x-forwarded-for"

# --- File storage (Phase 7) ----------------------------------------------------
# "local" keeps resumes in a private folder (outside /public, git-ignored).
# "s3" uses any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) — needed on serverless hosts.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com for R2
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- AI (Phase 8) ---------------------------------------------------------------
# Get a key at https://platform.claude.com. Without it, AI features show a "not configured" notice.
# ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- Scheduled jobs (Phase 11) --------------------------------------------------
# Secret for GET /api/cron/reminders (send as "Authorization: Bearer <secret>").
# Generate with: openssl rand -base64 32
# CRON_SECRET=""
